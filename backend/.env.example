# ============================================================
# Nabungin BACKEND — contoh environment variables
# Copy file ini menjadi .env lalu sesuaikan nilainya.
#   PowerShell:  Copy-Item .env.example .env
# ============================================================

# ---------- Database (PostgreSQL via Docker Compose) ----------
DATABASE_URL="postgresql://nabungin:nabungin@localhost:5433/nabungin?schema=public"

# ---------- Better Auth ----------
# Generate dengan: npx auth@latest secret   (atau: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# URL publik backend (dipakai Better Auth untuk cookie & callback).
BETTER_AUTH_URL="http://localhost:4000"

# ---------- Server ----------
PORT=4000
# Origin frontend yang diizinkan (CORS + trustedOrigins Better Auth).
CORS_ORIGIN="http://localhost:3000"

# ---------- App ----------
APP_NAME="Nabungin"
