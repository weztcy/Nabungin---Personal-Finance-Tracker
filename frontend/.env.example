# URL backend REST API (wajib). Dipakai untuk fetch server & Better Auth client.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---------- App ----------
NEXT_PUBLIC_APP_NAME="Nabungin"
NEXT_PUBLIC_BASE_CURRENCY="IDR"
NEXT_PUBLIC_TIMEZONE="Asia/Jakarta"
